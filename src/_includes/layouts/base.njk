<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {% set resolvedTitle = seoTitle if seoTitle else ((title ~ " | " ~ site.name) if title else site.name) -%}
    {% set resolvedDescription = description if description else site.defaultDescription -%}
    {% set canonicalUrl = site.url ~ page.url -%}
    <title>{{ resolvedTitle }}</title>
    <meta name="description" content="{{ resolvedDescription }}" />
    <link rel="canonical" href="{{ canonicalUrl }}" />
    <meta name="theme-color" content="{{ site.themeColor }}" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="{{ site.name }}" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content="{{ resolvedTitle }}" />
    <meta property="og:description" content="{{ resolvedDescription }}" />
    <meta property="og:url" content="{{ canonicalUrl }}" />
    <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}" />
    <meta property="og:image:alt" content="{{ site.ogImageAlt }}" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="{{ site.ogImageWidth }}" />
    <meta property="og:image:height" content="{{ site.ogImageHeight }}" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ resolvedTitle }}" />
    <meta name="twitter:description" content="{{ resolvedDescription }}" />
    <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}" />
    <meta name="twitter:image:alt" content="{{ site.ogImageAlt }}" />
    <link rel="stylesheet" type="text/css" href="/css/style.css"/>
    <style>
      .gradient {
        background: linear-gradient(90deg, #ff5a0b 0%, #ffad00 100%);
      }
    </style>
  </head>

  <body class="leading-normal tracking-normal text-white text-opacity-80 h-14 bg-gradient-to-r to-launchlead-gradient-to from-launchlead-gradient-from" style="font-family: 'Source Sans Pro', sans-serif;">
    <a class="skip-link" href="#content">Skip to content</a>
    {% include "../components/navigation.njk" %}
      <main id="content" tabindex="-1">
        {{ content | safe }}
      </main>
     {% include "../components/footer.njk" %}

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>

    <script>
      var scrollpos = window.scrollY;
      var header = document.getElementById("header");
      var navcontent = document.getElementById("nav-content");
      var navaction = document.getElementById("navAction");
      var navlogoWhite = document.getElementById("navLogoWhite");
      var navlogoBlue = document.getElementById("navLogoBlue");
      var brandname = document.getElementById("brandname");
      var toToggle = document.querySelectorAll(".toggleColour");
      var navMenu = document.getElementById("nav-toggle");
      var navLinks = document.querySelectorAll(".navLinksClass");
      document.addEventListener("scroll", function () {
        /* Apply classes for slide in bar */
        scrollpos = window.scrollY;

        if (scrollpos > 10) {
          header.classList.add("bg-white");
          navlogoBlue.classList.remove("hidden");
          navlogoBlue.classList.add("block");
          navlogoWhite.classList.add("hidden");
          navlogoWhite.classList.remove("block");
          navaction.classList.remove("bg-white");
          navaction.classList.add("gradient");
          navaction.classList.remove("text-gray-600");
          navMenu.classList.remove("text-white");
          navMenu.classList.remove("lg:text-white");
          navMenu.classList.add("text-gray-600");
          navLinks.forEach(el => {
            el.classList.remove("lg:text-white");
            el.classList.add("text-gray-600");
          });
          //Use to switch toggleColour colours
          for (var i = 0; i < toToggle.length; i++) {
            toToggle[i].classList.add("text-gray-600");
            toToggle[i].classList.remove("text-white");
          }
          header.classList.add("shadow");
          navcontent.classList.remove("bg-gray-100");
          navcontent.classList.add("bg-white");
        } else {
          navlogoBlue.classList.add("hidden");
          navlogoBlue.classList.remove("block");
          navlogoWhite.classList.remove("hidden");
          navlogoWhite.classList.add("block");
          navlogoBlue.classList.add("hidden");
          header.classList.remove("bg-white");
          navaction.classList.add("bg-white");
          navaction.classList.remove("text-white");
          navaction.classList.add("text-gray-600");
          navMenu.classList.add("text-white");
          navMenu.classList.add("lg:text-white");
          navMenu.classList.remove("text-gray-600");
          navLinks.forEach(el => {
            el.classList.add("lg:text-white");
          });

          //Use to switch toggleColour colours
          for (var i = 0; i < toToggle.length; i++) {
            toToggle[i].classList.add("text-white");
            toToggle[i].classList.remove("text-gray-600");
          }

          header.classList.remove("shadow");
          navcontent.classList.remove("bg-white");
          navcontent.classList.add("bg-gray-100");
        }
      });
    </script>

    <script>
      var navMenuDiv = document.getElementById("nav-content");
      var navMenu = document.getElementById("nav-toggle");

      function setMenuOpen(open) {
        if (open) {
          navMenuDiv.classList.remove("hidden");
          navMenu.innerText = "Close";
          navMenu.setAttribute("aria-expanded", "true");
        } else {
          navMenuDiv.classList.add("hidden");
          navMenu.innerText = "Menu";
          navMenu.setAttribute("aria-expanded", "false");
        }
      }

      document.onclick = check;
      function check(e) {
        var target = (e && e.target) || (event && event.srcElement);

        //Nav Menu
        if (!checkParent(target, navMenuDiv)) {
          // click NOT on the menu
          if (checkParent(target, navMenu)) {
            // click on the toggle
            setMenuOpen(navMenuDiv.classList.contains("hidden"));
          } else {
            // click both outside link and outside menu, hide menu
            setMenuOpen(false);
          }
        }
      }

      function checkParent(t, elm) {
        while (t.parentNode) {
          if (t == elm) {
            return true;
          }
          t = t.parentNode;
        }
        return false;
      }

    </script>
  </body>
</html>